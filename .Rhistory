install.packages('ggplot2')
#| label: preparar-datos
#| include: false
if (!requireNamespace("ggplot2", quietly = TRUE)) {
stop("Falta ggplot2. Ejecuta install.packages('ggplot2') en la consola de R.")
}
library(ggplot2)
## El proyecto Quarto contiene execute-dir: project.
## Por ello, la ruta parte de la carpeta principal del repositorio.
ruta_base <- "datos/procesados/base_estudio.rds"
if (!file.exists(ruta_base)) {
stop("No se encuentra datos/procesados/base_estudio.rds. Guarda este QMD dentro del proyecto GitHub y comprueba la ruta.")
}
base_estudio <- readRDS(ruta_base)
variables <- c("sector", "horas_anuales", "valor_agregado",
"personal_ocupado", "factor_expansion")
if (!all(variables %in% names(base_estudio))) {
stop("La base procesada no contiene todas las variables requeridas.")
}
## Replicamos el filtro utilizado en scripts/02_diagnostico_sectorial.R.
## Se conservan empresas con valor agregado igual a cero o negativo.
base_1 <- subset(
base_estudio,
!is.na(sector) & trimws(as.character(sector)) != "" &
is.finite(horas_anuales) &
is.finite(valor_agregado) &
is.finite(personal_ocupado) &
is.finite(factor_expansion) &
horas_anuales > 0 &
personal_ocupado > 0 &
factor_expansion > 0
)
sectores <- c("Comercio", "Construcción", "Manufactura", "Minería", "Servicios")
base_1$sector <- factor(as.character(base_1$sector), levels = sectores)
if (anyNA(base_1$sector)) {
stop("Se encontraron sectores diferentes de los cinco previstos. Revisa unique(base_estudio$sector).")
}
## Indicadores a escala de cada empresa.
base_1$horas_por_trabajador <- base_1$horas_anuales / base_1$personal_ocupado
base_1$productividad_por_trabajador <- base_1$valor_agregado / base_1$personal_ocupado
## Funciones de presentación con formato numérico español.
num_es <- function(x, decimales = 1) {
formatC(x, format = "f", digits = decimales,
big.mark = ".", decimal.mark = ",")
}
etiquetas_es <- function(x) {
format(round(x), big.mark = ".", decimal.mark = ",",
scientific = FALSE, trim = TRUE)
}
#| label: tbl-distribucion
#| tbl-cap: "Distribución de empresas de la muestra por sector económico, ENESEM 2019"
frecuencias <- table(base_1$sector)
tabla_1 <- data.frame(
Sector = names(frecuencias),
Empresas = as.integer(frecuencias),
Porcentaje = 100 * as.integer(frecuencias) / nrow(base_1)
)
knitr::kable(
data.frame(
"Sector económico" = tabla_1$Sector,
"Empresas" = tabla_1$Empresas,
"Porcentaje de la muestra (%)" = num_es(tabla_1$Porcentaje, 2),
check.names = FALSE
),
align = c("l", "r", "r")
)
